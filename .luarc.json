{
  "$schema": "https://raw.githubusercontent.com/LuaLS/vscode-lua/master/setting/schema.json",
  "runtime.version": "Lua 5.1",
  "runtime.builtin": {
    "basic": "disable",
    "bit": "disable",
    "bit32": "disable",
    "builtin": "disable",
    "coroutine": "enable",
    "debug": "enable",
    "ffi": "disable",
    "io": "enable",
    "jit": "disable",
    "math": "enable",
    "os": "enable",
    "package": "enable",
    "string": "enable",
    "table": "enable",
    "utf8": "disable"
  },
  "workspace.library": [
    "meta"
  ],
  "workspace.ignoreDir": [
    "docs",
    "gfx",
    "sfx",
    "sys/logs",
    "sys/cache",
    "sys/stats"
  ],
  "diagnostics.globals": [
    "addhook",
    "addbind",
    "removebind",
    "removeallbinds",
    "freehook",
    "sethookstate",
    "funcs",
    "vars",
    "timer",
    "freetimer",
    "image",
    "freeimage",
    "imagealpha",
    "imageblend",
    "imagecolor",
    "imageframe",
    "imagehitzone",
    "imageparam",
    "imagepos",
    "imagescale",
    "tween_alpha",
    "tween_animate",
    "tween_color",
    "tween_frame",
    "tween_move",
    "tween_rotate",
    "tween_rotateconstantly",
    "tween_scale",
    "freeline",
    "freerect",
    "game",
    "map",
    "tile",
    "tileproperty",
    "entity",
    "entitylist",
    "inentityzone",
    "randomentity",
    "setentityaistate",
    "object",
    "objectat",
    "objecttype",
    "closeobjects",
    "player",
    "playerammo",
    "playerweapons",
    "closeplayers",
    "hascloseplayers",
    "closeitems",
    "item",
    "itemtype",
    "projectile",
    "projectilelist",
    "hostage",
    "closehostage",
    "randomhostage",
    "menu",
    "msg",
    "msg2",
    "parse",
    "print",
    "fow_in",
    "checksumfile",
    "checksumstring",
    "reqcld",
    "reqhttp",
    "stats",
    "steamstats",
    "ai_aim",
    "ai_attack",
    "ai_build",
    "ai_buy",
    "ai_debug",
    "ai_drop",
    "ai_findtarget",
    "ai_freeline",
    "ai_goto",
    "ai_iattack",
    "ai_move",
    "ai_radio",
    "ai_reload",
    "ai_respawn",
    "ai_rotate",
    "ai_say",
    "ai_sayteam",
    "ai_selectweapon",
    "ai_spray",
    "ai_use",
    "sample"
  ],
  "diagnostics.disable": [
    "lowercase-global",
    "redundant-parameter",
    "redundant-value",
    "undefined-field",
    "assign-type-mismatch",
    "param-type-mismatch"
  ]
}
